# Copy this file to .env, then add the organizer-provided gateway settings.
OPENAI_BASE_URL=https://<approved-gateway>/v1
OPENAI_API_KEY=<organizer-provided-key>

# Optional fallback; leave empty when setting a model for each agent.
OPENAI_MODEL=

# Comma-separated exact model IDs supported by the gateway.
AVAILABLE_MODELS=<model-id-1>,<model-id-2>,<model-id-3>

# Each selection must exactly match one entry in AVAILABLE_MODELS.
ARCH_AGENT_1_MODEL=<model-id-for-D1>
ARCH_AGENT_2_MODEL=<model-id-for-D2>
ARCH_AGENT_3_MODEL=<model-id-for-D3>
ARCH_AGENT_4_MODEL=<model-id-for-D4>
ARCH_AGENT_5_MODEL=<model-id-for-D5>

# Optional overrides. By default Node is found on PATH, project node_modules
# from npm ci are used, and installed Chromium is preferred (Edge fallback).
# Codex's bundled runtime is only an additional fallback, not a requirement.
# PIPELINE_NODE=C:/path/to/node.exe
# PIPELINE_NODE_MODULES=C:/path/to/node_modules
# PIPELINE_BROWSER_CHANNEL=auto
# Use chromium to require the browser installed by npm run install:browsers.
